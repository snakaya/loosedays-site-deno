{
  "tasks": {
    "start": "deno run -A --watch=static/,routes/ app/dev.ts",
    "build": "deno run -A app/dev.ts build",
    "preview": "deno run -A app/main.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "imports": {
    "$fresh/": "https://deno.land/x/fresh@1.7.3/",
    "preact": "npm:preact@10.22.0",
    "preact/debug": "npm:preact@10.22.0/debug",
    "preact/devtools": "npm:preact@10.22.0/devtools",
    "preact/hooks": "npm:preact@10.22.0/hooks",
    "preact/jsx-runtime": "npm:preact@10.22.0/jsx-runtime",
    "preact-render-to-string": "npm:preact-render-to-string@6.3.1",
    "twind": "https://esm.sh/twind@1.1.3",
    "twind/": "https://esm.sh/twind@1.1.3/",
    "react-icons/si": "https://cdn.jsdelivr.net/gh/urielch/react-icons-si@1.0.9/mod.ts",
    "react-icons/tb": "https://cdn.jsdelivr.net/gh/urielch/react-icons-tb@1.0.9/mod.ts",
    "@preact/signals": "npm:@preact/signals@1.2.2",
    "@preact/signals-core": "npm:@preact/signals-core@1.5.1",
    "@twind/core": "npm:@twind/core@1.1.3",
    "@twind/preset-tailwind": "npm:@twind/preset-tailwind@1.1.4",
    "@twind/preset-autoprefix": "https://esm.sh/@twind/preset-autoprefix@1.0.7/"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "deploy": {
    "org": "loosedays",
    "app": "loosedays-site",
    "build": "deno task build",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "app/main.ts"
    }
  }
}
